{
  "name": "turnos-app-firebase",
  "private": true,
  "description": "Herramientas de Firebase para la app de turnos (emuladores; design.md §6).",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-turnos",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-turnos \"node --test rules-tests/*.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-turnos \"node scripts/e2e.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.35.0"
  }
}
