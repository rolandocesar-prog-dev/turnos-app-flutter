rules_version = '2';

// Reglas de seguridad (RNF-01, design.md §4). Pruebas: rules-tests/ (npm run test:rules).
// Todo lo que no está permitido aquí queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // El rol se lee del perfil; un perfil inexistente no es admin.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // El administrador lee los perfiles para saber de quién es cada reserva (design.md §11).
      allow read: if isOwner(uid) || isAdmin();
      // Nadie se crea como admin y el correo es el de su sesión.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'client'
        && request.resource.data.email == request.auth.token.email;
      // Ni el rol ni el correo se cambian desde la app. Los tokens de FCM son una lista corta
      // (design.md §13).
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'fcmTokens'])
        && (!('fcmTokens' in request.resource.data)
          || (request.resource.data.fcmTokens is list
            && request.resource.data.fcmTokens.size() <= 10));
      allow delete: if false;
    }

    // Recurso con los campos del modelo y valores razonables (design.md §3 y §11).
    function validResource(data) {
      return data.keys().hasOnly([
          'name', 'description', 'photoUrl', 'slotMinutes', 'active', 'weeklySchedule',
          'blockedDates'
        ])
        && data.keys().hasAll(['name', 'slotMinutes', 'active', 'weeklySchedule'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && (!('description' in data) || (data.description is string
          && data.description.size() <= 300))
        && (!('photoUrl' in data) || data.photoUrl is string)
        && data.slotMinutes is int && data.slotMinutes >= 5 && data.slotMinutes <= 240
        && data.active is bool
        && data.weeklySchedule is map
        && data.weeklySchedule.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && (!('blockedDates' in data) || data.blockedDates is list);
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validResource(request.resource.data);
      // No se borra: se desactiva, y las reservas que lo nombran siguen teniendo sentido.
      allow delete: if false;

      // Ocupación de franjas: se lee para mostrar el estado (RF-02). Solo datos opacos.
      match /slots/{slotId} {
        allow read: if signedIn();

        // Reservar (RF-03): el slot solo se CREA si no existe (pisarlo sería una actualización,
        // que no está permitida), junto con su reserva en la misma transacción.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['bookingId', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && bookingAfter(request.resource.data.bookingId).uid == request.auth.uid
          && bookingAfter(request.resource.data.bookingId).resourceId == resourceId
          && bookingAfter(request.resource.data.bookingId).slotId == slotId
          && bookingAfter(request.resource.data.bookingId).status == 'active';

        // Cancelar (RF-04, RF-06): el dueño o el administrador liberan el slot solo si la reserva
        // queda cancelada.
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isAdmin())
          && bookingAfter(resource.data.bookingId).status == 'cancelled';
      }
    }

    // Reserva tal como quedará al terminar la transacción.
    function bookingAfter(bookingId) {
      return getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    match /bookings/{bookingId} {
      // Cada cliente lee solo sus reservas (las consultas deben filtrar por su uid); el
      // administrador, todas.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly([
          'resourceId', 'resourceName', 'slotId', 'uid', 'startAt', 'endAt', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startAt is timestamp
        && request.resource.data.startAt > request.time
        && request.resource.data.endAt > request.resource.data.startAt
        && get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId))
          .data.active == true
        && getAfter(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)/slots/$(request.resource.data.slotId))
          .data.bookingId == bookingId;

      // Cancelar: el cliente, con al menos 2 horas de anticipación según la hora del servidor; el
      // administrador, antes de que empiece y con un motivo. Siempre se libera la franja en el
      // mismo lote.
      allow update: if resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && !existsAfter(/databases/$(database)/documents/resources/$(resource.data.resourceId)/slots/$(resource.data.slotId))
        && (clientCancel() || adminCancel());

      function clientCancel() {
        return isOwner(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
          && request.time <= resource.data.startAt - duration.value(2, 'h');
      }

      function adminCancel() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'cancelReason'])
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() >= 3
          && request.resource.data.cancelReason.size() <= 200
          && request.time < resource.data.startAt;
      }

      allow delete: if false;
    }
  }
}
